# Supabase Configuration (copy to .env.local and fill in your values)
# Create a Supabase project → Settings → API → Copy these values

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use EITHER the legacy anon key OR the newer publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# OR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
