# Supabase Configuration (copy to .env.local and fill in your values)
# Create a Supabase project → Settings → API → Copy these values

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Frontend keys: Use EITHER the legacy anon key OR the newer publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# OR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-side Keep-Alive / GitHub Actions Secrets:
# For GitHub Actions keep-alive (.github/workflows/supabase-keepalive.yml):
# Add these in GitHub Repo -> Settings -> Secrets and variables -> Actions:
# - SUPABASE_URL (e.g. https://your-project-ref.supabase.co)
# - SUPABASE_ANON_KEY (your anon or publishable key)
# - SUPABASE_SERVICE_ROLE_KEY (optional, for administrative keepalive)

# Optional secret to protect /api/health from unauthorized public queries
# CRON_SECRET=your-secure-random-token
